; ions.mdp — 仅用于 genion 前 grompp（替换离子），不做实际积分
; 力场假设: AMBER99SB-ILDN + TIP3P；cutoff 1.0 nm 与后续各阶段一致
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
