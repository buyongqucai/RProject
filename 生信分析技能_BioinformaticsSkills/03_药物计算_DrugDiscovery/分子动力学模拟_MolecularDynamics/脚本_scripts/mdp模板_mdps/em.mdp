; em.mdp — 能量最小化（最速下降），消除溶剂化/加离子后的原子碰撞
; 收敛判据: 最大力 < 1000 kJ/mol/nm
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
